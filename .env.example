# Servidor
HOST=127.0.0.1
PORT=4173
NODE_ENV=development
APP_BASE_URL=http://127.0.0.1:4173

# Persistencia
DATABASE_PATH=data/social-audit-pro.sqlite

# Cifrado de credenciales OAuth y tokens.
# Usar un valor aleatorio largo y privado en .env. Nunca versionar el valor real.
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Credenciales oficiales. Completar solo las plataformas habilitadas.
META_CLIENT_ID=
META_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/api/v1/integrations/youtube/oauth/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
