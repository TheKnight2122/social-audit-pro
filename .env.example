# Servidor
HOST=127.0.0.1
PORT=4173
NODE_ENV=development
APP_BASE_URL=http://127.0.0.1:4173
TRUST_PROXY=false
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=66000
# Monitoreo global del proceso, solo para el operador del servidor. Vacio desactiva el endpoint.
# Usar 64 caracteres hexadecimales aleatorios, distintos de las otras claves.
OPERATIONS_METRICS_TOKEN=

# Persistencia
DATABASE_PATH=data/social-audit-pro.sqlite

# Copias cifradas. 0 desactiva la programacion; de 1 a 168 horas la activa.
# Clave exclusiva de 64 caracteres hexadecimales, respaldada fuera del servidor.
BACKUP_DIRECTORY=backups
BACKUP_INTERVAL_HOURS=0
BACKUP_ENCRYPTION_KEY=

# Sincronizacion automatica. El trabajador usa leases para evitar ejecuciones duplicadas.
SYNC_WORKER_ENABLED=true
SYNC_WORKER_POLL_MS=60000
SYNC_INTERVAL_MINUTES=360

# Cifrado de credenciales OAuth y tokens.
# Usar un valor aleatorio largo y privado en .env. Nunca versionar el valor real.
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Correo transaccional para verificacion y recuperacion.
# Enlaces de prueba solo con base desechable y servidor limitado a 127.0.0.1.
EMAIL_PREVIEW_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Social Audit Pro <no-reply@example.com>

# Credenciales oficiales. Completar solo las plataformas habilitadas.
META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_VERSION=v26.0
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/api/v1/integrations/instagram/oauth/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/api/v1/integrations/facebook/oauth/callback
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/api/v1/integrations/tiktok/oauth/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/api/v1/integrations/linkedin/oauth/callback
LINKEDIN_API_VERSION=202606
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/api/v1/integrations/youtube/oauth/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/api/v1/integrations/x/oauth/callback
X_API_BASE_URL=https://api.x.com
